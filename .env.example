# 复制为 .env 并按需修改。所有变量都有开发期默认值,不设也能跑(但 DB/Redis 必须可用)。

# ---- 持久化(必需)----
# Postgres 连接串。首次使用需建库 + 迁移 + 种子:
#   createdb auth-proxy
#   DATABASE_URL=... pnpm --filter @auth-proxy/db migrate
#   DATABASE_URL=... pnpm --filter @auth-proxy/db seed
DATABASE_URL=postgres://localhost:5432/auth-proxy
# Redis 连接串。建议用独立 db index 隔离(如 /2),避免污染其它程序
REDIS_URL=redis://localhost:6379/2

# ---- 中间层 server ----
SERVER_PORT=3000
# mock 公司应用基址(gateway 转发目标)。真实公司应用接入时改这里。
COMPANY_API_BASE=http://localhost:4000
# admin 后台(/admin/web/*)session cookie 签名密钥。部署时设强随机值。
ADMIN_SESSION_SECRET=
# 注意:admin 账号不在此配置。seed 不创建任何 admin(零默认,防弱口令)。
# 首个管理员手动创建:
#   DATABASE_URL=... pnpm --filter @auth-proxy/db create-admin
# 或部署后:
#   docker compose exec server node packages/db/dist/scripts/create-admin.js
# TLS:生产强烈建议启用。两种方式:
#   1. 推荐:前置 Nginx/Caddy 终止 TLS,中间层纯 HTTP(TLS_ENABLED=0)
#   2. 中间层直接 TLS:TLS_ENABLED=1 + 证书路径(自签或正规)
# 本地开发保持 0。
TLS_ENABLED=0
TLS_CERT_PATH=
TLS_KEY_PATH=

# ---- JWT(RS256;密钥从 signing_keys 表取,seed 时自动生成)----
JWT_ISSUER=auth-proxy
# access token 的 audience(RFC 9068 §3 要求必须有 aud)。标识资源服务器,
# 校验时必须匹配,防 token confusion。单一固定值适配当前单公司应用架构。
JWT_AUDIENCE=auth-proxy
JWT_ACCESS_TTL=3600       # 中间层 access token 有效期(秒)
JWT_REFRESH_TTL=604800    # refresh token 有效期(秒)
# 允许的 scope 白名单(空格分隔)。device_authorization 入口校验:请求的 scope
# 超出此集合 → invalid_scope(RFC 6749 §3.3)。offline_access 由入口自动补上。
ALLOWED_SCOPES=orders:read orders:write products:read invoices:read admin offline_access

# ---- device flow ----
DEVICE_CODE_TTL=600       # device_code 有效期(秒)
DEVICE_POLL_INTERVAL=5    # CLI 轮询间隔(秒)
# refresh 重用检测:旧 refresh 在此窗口内复用视为合法(容忍并发),
# 超窗口视为泄露 → 吊销 session。OAuth 安全 BCP 建议 30s-数分钟。
REFRESH_REUSE_GRACE_SEC=30

# ---- 限流(Redis 计数,默认宽松)----
RL_LOGIN_WINDOW_MS=60000  # 登录尝试窗口(ms)
RL_LOGIN_MAX=20           # 每 IP 每窗口最大登录次数
RL_TOKEN_WINDOW_MS=60000  # /token 请求窗口
RL_TOKEN_MAX=120          # 每 client 每窗口最大次数(含 device_code 轮询)
RL_PROXY_WINDOW_MS=60000  # gateway 请求窗口
RL_PROXY_MAX=300          # 每 session 每窗口最大次数

# ---- mock 公司应用 ----
MOCK_PORT=4000
# access token 过期秒数;默认 60 便于测 gateway 自动刷新
TOKEN_TTL=60

# ---- CLI(也可用环境变量覆盖 ~/.super-cli/config.json)----
# SUPERCLI_BASE_URL=http://localhost:3000
# SUPERCLI_CLIENT_ID=demo_app
# SUPERCLI_CLIENT_SECRET=demo_secret
